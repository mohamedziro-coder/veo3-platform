# Environment Variables Template
# Copy this file to .env.local and fill in your values

# =====================================================
# DATABASE (REQUIRED)
# =====================================================
# Get this from: https://console.neon.tech
POSTGRES_URL=postgresql://[user]:[password]@[host]/[database]?sslmode=require

# =====================================================
# EMAIL SERVICE (REQUIRED FOR AUTH)
# =====================================================
RESEND_API_KEY=re_your_resend_api_key_here

# =====================================================
# RUNWAY ML API (REQUIRED FOR VIDEO / IMAGE / VOICE)
# =====================================================
# Get your API key from: https://app.runwayml.com/settings
RUNWAYML_API_SECRET=your_runway_api_key_here

# =====================================================
# GEMINI API (OPTIONAL — for blog AI generation only)
# =====================================================
# Get your free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# =====================================================
# NEXT.js
# =====================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
PRIMARY_ADMIN_EMAIL=your@email.com

# =====================================================
# STRIPE (REQUIRED FOR CREDIT PURCHASES)
# =====================================================
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
